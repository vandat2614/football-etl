# ==========================================
# Football ETL Environment Configuration
# ==========================================

# --- PostgreSQL Database ---
POSTGRES_USER=football
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=football_etl
# Note: Format must match: postgresql+psycopg2://<USER>:<PASSWORD>@postgres:5432/<DB>
DATABASE_URL=postgresql+psycopg2://football:change_this_password@postgres:5432/football_etl

# --- Kafka Broker ---
# Address of Kafka broker reachable from inside the Docker containers
# If running Kafka on another VM/Host, provide IP:PORT, e.g. 168.107.88.236:9092
KAFKA_BOOTSTRAP_SERVERS=168.107.88.236:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- API Settings ---
# Secret token for protecting POST /ingest and GET /crawl-state
API_TOKEN=your_secure_random_api_token
# Public URL and domain (used for CORS and scheduler)
API_URL=https://your-domain.duckdns.org
API_DOMAIN=your-domain.duckdns.org

# --- Optional Defaults ---
DEFAULT_SEASON=2025-2026
LOG_LEVEL=INFO
